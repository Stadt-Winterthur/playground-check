# Netzwerkfreigabe auf dem Linux-Host. Für Reverse-Proxy-Betrieb lokal belassen.
PLAYGROUND_BIND_ADDRESS=127.0.0.1
PLAYGROUND_PUBLISHED_PORT=8010

# Vor dem ersten produktiven Start zwingend ersetzen.
PLAYGROUND_POSTGRES_DSN=postgresql://BENUTZER:PASSWORT@POSTGRES-HOST:5432/DATENBANK?sslmode=require
PLAYGROUND_SECURITY_KEY=HIER_LANGEN_ZUFAELLIGEN_SIGNATURSCHLUESSEL_EINTRAGEN
PLAYGROUND_SALT_BASE64=HIER_ORIGINALEN_BASE64_SALT_EINTRAGEN
PLAYGROUND_SERVICE_URL=https://spielplatzkontrolle.example.ch/

PLAYGROUND_TITLE=Spielplatzkontrolle
PLAYGROUND_SHORT_TITLE=SPK
PLAYGROUND_TOKEN_KEY=playground.token
PLAYGROUND_USER_TOKEN_KEY=playground.user.token
PLAYGROUND_HIDE_INFO_COOKIE_NAME=hide_info
PLAYGROUND_WMS_URL=http://stadtplan.winterthur.ch/wms/Spielplatzkarte
PLAYGROUND_COMPATIBILITY_BUGS=true
PLAYGROUND_SERVICE_WORKER_ENABLED=true
# Optional: externer Unterpfad der kombinierten App (Legacy-Alias: URL__ServiceBasePath).
PLAYGROUND_BASE_PATH=

# Optional Swagger/OpenAPI service description (legacy: ServiceDescription)
PLAYGROUND_SERVICE_DESCRIPTION=

# Optionales Legacy-kompatibles ELK-Logging (Aliases: ELK__Url, ELK__VerifySsl,
# ELK__Environment, ELK__Directory, ELK__Service). Leer = nur lokales Logging.
PLAYGROUND_ELK_URL=
PLAYGROUND_ELK_VERIFY_SSL=false
PLAYGROUND_ELK_ENVIRONMENT=production
PLAYGROUND_ELK_DIRECTORY=
PLAYGROUND_ELK_SERVICE=playground-check-service

# Legacy-Feature-Flags. In den Original-Environments sind beide deaktiviert.
PLAYGROUND_FEATURE_PUSH_NOTIFICATIONS=false
PLAYGROUND_VAPID_PUBLIC_KEY=BGwoqHwV5SrixvSr9YQ58M9U5MzFZ7m5rCrWrGBmMpPVkaWbCwJtL7KWAZFTeZps_2zcdguI1_R-ZtgpLIzPu6Y

# SMTP-Versand von Mangel-Infomails
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=mail@domain.ch
SMTP_TIMEOUT=10
