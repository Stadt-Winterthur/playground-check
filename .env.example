# Optionales Legacy-kompatibles ELK-Logging (Aliases: ELK__Url, ELK__VerifySsl,
# ELK__Environment, ELK__Directory, ELK__Service). Leer = nur lokales Logging.
PLAYGROUND_ELK_URL=
PLAYGROUND_ELK_VERIFY_SSL=false
PLAYGROUND_ELK_ENVIRONMENT=development
PLAYGROUND_ELK_DIRECTORY=
PLAYGROUND_ELK_SERVICE=playground-check-service

